    "deploy": {
      "type": "binary",
      "steps": [
        "curl -fL -o xuexitong-ppt-downloader.user.js https://github.com/hazuki-keatsu/xuexitong-ppt-downloader/raw/main/dist/tampermonkey/xuexitong-ppt-downloader.user.js",
        "ls -l xuexitong-ppt-downloader.user.js",
        "echo \"在 Tampermonkey 里导入该文件并启用\""
      ],
      "stepsPs": [
        "curl.exe -fL -o xuexitong-ppt-downloader.user.js https://github.com/hazuki-keatsu/xuexitong-ppt-downloader/raw/main/dist/tampermonkey/xuexitong-ppt-downloader.user.js",
        "Get-Item xuexitong-ppt-downloader.user.js | Select-Object Name, Length",
        "Write-Host '在 Tampermonkey 里导入该文件并启用'"
      ],
      "source": "https://github.com/hazuki-keatsu/xuexitong-ppt-downloader#readme"
    },
    "pitfalls": [
      "没有导出按钮：确认脚本已启用并刷新页面",
      "导出失败：减少同时打开的课件数量",
      "PDF 顺序错乱：按导出文件名排序合并",
      "扩展加载失败：确认选的是解压后的目录而不是 zip",
      "内存不足：分卷导出或换更高配置的电脑",
      "图片模糊：关闭压缩选项后重试",
      "页面改版失效：等作者更新脚本"
    ]
  },
